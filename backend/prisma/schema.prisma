generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model achievements {
  id         String   @id
  user_id    String
  type       String
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model admin_activity_logs {
  id              String          @id
  admin_id        String
  action          String
  target_type     String?
  target_id       String?
  details         Json?
  ip_address      String?
  created_at      DateTime        @default(now())
  platform_admins platform_admins @relation(fields: [admin_id], references: [id])

  @@index([admin_id, created_at])
}

model admin_invitations {
  id              String          @id
  email           String          @unique
  token           String          @unique
  invited_by_id   String
  expires_at      DateTime
  used_at         DateTime?
  created_at      DateTime        @default(now())
  platform_admins platform_admins @relation(fields: [invited_by_id], references: [id])
}

model ai_usage_logs {
  id           String      @id
  user_id      String
  household_id String?
  type         AiLogType
  tokens       Int         @default(0)
  country      String?
  created_at   DateTime    @default(now())
  households   households? @relation(fields: [household_id], references: [id])
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([household_id, type])
  @@index([user_id, type])
}

model announcements {
  id         String    @id
  title      String
  message    String
  type       String    @default("info")
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  expires_at DateTime?
}

model blacklisted_tokens {
  id         String   @id
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model custom_categories {
  id              String       @id
  household_id    String
  name            String
  type            CategoryType
  parent_category String?
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  households      households   @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@unique([household_id, name])
}

model daily_insights {
  id         String   @id
  date       DateTime @unique @db.Date
  news       Json
  quotes     Json
  created_at DateTime @default(now())
  updated_at DateTime
}

model feedback {
  id         String   @id
  user_id    String
  type       String   @default("general")
  message    String
  status     String   @default("pending")
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id])
}

model goals {
  id             String         @id
  household_id   String
  name           String
  type           GoalType
  target_amount  Decimal?       @db.Decimal(10, 2)
  current_amount Decimal        @default(0) @db.Decimal(10, 2)
  deadline       DateTime?      @db.Date
  is_active      Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime
  created_by_id  String?
  users          users?         @relation(fields: [created_by_id], references: [id])
  households     households     @relation(fields: [household_id], references: [id], onDelete: Cascade)
  transactions   transactions[]

  @@index([household_id, is_active])
}

model households {
  id                                   String               @id
  name                                 String
  invite_code                          String               @unique
  admin_id                             String
  last_modified_at                     DateTime             @default(now())
  created_at                           DateTime             @default(now())
  currency                             String               @default("USD")
  ai_request_count                     Int                  @default(0)
  is_ai_restricted                     Boolean              @default(false)
  country                              String?
  ai_settings                          Json?
  ai_usage_logs                        ai_usage_logs[]
  custom_categories                    custom_categories[]
  goals                                goals[]
  users_households_admin_idTousers     users                @relation("households_admin_idTousers", fields: [admin_id], references: [id])
  incomes                              incomes[]
  invitations                          invitations[]
  loans                                loans[]
  recurring_expenses                   recurring_expenses[]
  reports                              reports[]
  split_expenses                       split_expenses[]
  transactions                         transactions[]
  users_users_household_idTohouseholds users[]              @relation("users_household_idTohouseholds")
}

model incomes {
  id           String          @id
  household_id String
  user_id      String
  amount       Decimal         @db.Decimal(10, 2)
  currency     String          @default("USD")
  source       String
  type         IncomeType
  frequency    IncomeFrequency
  start_date   DateTime        @db.Date
  end_date     DateTime?       @db.Date
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now())
  updated_at   DateTime
  households   households      @relation(fields: [household_id], references: [id], onDelete: Cascade)
  users        users           @relation(fields: [user_id], references: [id])

  @@index([household_id, is_active])
}

model invitations {
  id              String           @id
  household_id    String
  invited_by_id   String
  recipient_email String?
  recipient_phone String?
  role            Role
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expires_at      DateTime
  accepted_at     DateTime?
  created_at      DateTime         @default(now())
  households      households       @relation(fields: [household_id], references: [id], onDelete: Cascade)
  users           users            @relation(fields: [invited_by_id], references: [id])

  @@unique([household_id, recipient_email], map: "unique_household_email")
  @@unique([household_id, recipient_phone], map: "unique_household_phone")
}

model loan_repayments {
  id         String   @id
  loan_id    String
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  method     String?
  note       String?
  created_at DateTime @default(now())
  loans      loans    @relation(fields: [loan_id], references: [id], onDelete: Cascade)
}

model loans {
  id               String            @id
  household_id     String
  user_id          String
  type             LoanType
  person_name      String
  principal_amount Decimal           @db.Decimal(10, 2)
  remaining_amount Decimal           @db.Decimal(10, 2)
  due_date         DateTime?         @db.Date
  notes            String?
  is_settled       Boolean           @default(false)
  created_at       DateTime          @default(now())
  updated_at       DateTime
  loan_repayments  loan_repayments[]
  households       households        @relation(fields: [household_id], references: [id], onDelete: Cascade)
  users            users             @relation(fields: [user_id], references: [id])

  @@index([household_id, is_settled])
}

model platform_admins {
  id                  String                @id
  email               String                @unique
  username            String                @unique
  password_hash       String
  first_name          String
  last_name           String
  avatar_url          String?
  adminLevel          AdminLevel            @default(STANDARD)
  last_login_at       DateTime?
  last_login_ip       String?
  two_factor_enabled  Boolean               @default(false)
  two_factor_secret   String?
  is_active           Boolean               @default(true)
  is_super_admin      Boolean               @default(false)
  created_at          DateTime              @default(now())
  updated_at          DateTime
  admin_activity_logs admin_activity_logs[]
  admin_invitations   admin_invitations[]
}

model recurring_expenses {
  id           String             @id
  household_id String
  name         String
  amount       Decimal            @db.Decimal(10, 2)
  category     String
  subcategory  String?
  frequency    RecurringFrequency
  skip_dates   Json               @default("[]")
  is_active    Boolean            @default(true)
  start_date   DateTime           @db.Date
  end_date     DateTime?          @db.Date
  created_at   DateTime           @default(now())
  updated_at   DateTime
  households   households         @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@index([household_id, is_active])
}

model reports {
  id           String                 @id
  household_id String
  type         String
  created_at   DateTime               @default(now())
  content      Json
  date_end     DateTime               @db.Date
  date_start   DateTime               @db.Date
  embedding    Unsupported("vector")?
  households   households             @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@index([household_id, created_at])
}

model split_expenses {
  id               String             @id
  household_id     String
  transaction_id   String
  total_amount     Decimal            @db.Decimal(10, 2)
  your_share       Decimal            @db.Decimal(10, 2)
  splits           Json
  is_fully_settled Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  households       households         @relation(fields: [household_id], references: [id], onDelete: Cascade)
  transactions     transactions       @relation(fields: [transaction_id], references: [id])
  split_repayments split_repayments[]
}

model split_repayments {
  id               String         @id
  split_expense_id String
  person_name      String
  amount           Decimal        @db.Decimal(10, 2)
  date             DateTime       @db.Date
  method           String?
  created_at       DateTime       @default(now())
  split_expenses   split_expenses @relation(fields: [split_expense_id], references: [id], onDelete: Cascade)
}

model system_settings {
  key         String   @id
  value       String
  description String?
  updated_at  DateTime
}

model transactions {
  id             String                 @id
  household_id   String
  user_id        String
  amount         Decimal                @db.Decimal(10, 2)
  currency       String                 @default("USD")
  merchant       String?
  description    String
  category       String
  subcategory    String?
  type           TransactionType
  date           DateTime               @db.Date
  ai_categorized Boolean                @default(false)
  confidence     Float?
  user_override  Boolean                @default(false)
  deleted_at     DateTime?
  created_at     DateTime               @default(now())
  updated_at     DateTime
  goal_id        String?
  embedding      Unsupported("vector")?
  split_expenses split_expenses[]
  goals          goals?                 @relation(fields: [goal_id], references: [id])
  households     households             @relation(fields: [household_id], references: [id], onDelete: Cascade)
  users          users                  @relation(fields: [user_id], references: [id])

  @@index([category, type])
  @@index([household_id, date])
}

model users {
  id                                        String          @id
  email                                     String          @unique
  phone                                     String
  password_hash                             String
  first_name                                String
  last_name                                 String
  currency                                  String          @default("USD")
  avatar_url                                String?
  timezone                                  String          @default("UTC")
  notification_preferences                  Json            @default("{}")
  household_id                              String?
  role                                      Role            @default(VIEWER)
  email_verified                            Boolean         @default(false)
  phone_verified                            Boolean         @default(false)
  reset_token                               String?
  reset_token_expiry                        DateTime?
  created_at                                DateTime        @default(now())
  updated_at                                DateTime
  verification_token                        String?
  verification_token_expiry                 DateTime?
  ai_request_count                          Int             @default(0)
  ai_token_count                            Int             @default(0)
  is_ai_restricted                          Boolean         @default(false)
  ai_settings                               Json?
  country                                   String?
  last_ip                                   String?
  city                                      String?
  current_streak                            Int             @default(0)
  last_log_date                             DateTime?
  longest_streak                            Int             @default(0)
  rank_progress                             Int             @default(0)
  rank_tier                                 String          @default("NOVICE")
  state                                     String?
  total_points                              Int             @default(0)
  weekly_activity_log                       Json            @default("[]")
  last_reports_viewed_at                    DateTime?
  cookie_accepted_at                        DateTime?
  privacy_accepted_at                       DateTime?
  terms_accepted_at                         DateTime?
  achievements                              achievements[]
  ai_usage_logs                             ai_usage_logs[]
  feedback                                  feedback[]
  goals                                     goals[]
  households_households_admin_idTousers     households[]    @relation("households_admin_idTousers")
  incomes                                   incomes[]
  invitations                               invitations[]
  loans                                     loans[]
  transactions                              transactions[]
  households_users_household_idTohouseholds households?     @relation("users_household_idTohouseholds", fields: [household_id], references: [id])
}

enum AdminLevel {
  STANDARD
  MODERATOR
  ADMINISTRATOR
}

enum AiLogType {
  CHAT
  SMART_ENTRY
  REPORT
}

enum CategoryType {
  NEEDS
  WANTS
  SAVINGS
}

enum GoalType {
  EMERGENCY_FUND
  SINKING_FUND
  DEBT_PAYOFF
  LONG_TERM
}

enum IncomeFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum IncomeType {
  PRIMARY
  VARIABLE
  PASSIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum LoanType {
  LENT
  BORROWED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum TransactionType {
  NEED
  WANT
  SAVINGS
}
